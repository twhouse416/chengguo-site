<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex, nofollow" />
<link rel="icon" type="image/png" href="../assets/logo-icon.png" />
<title>文章後台｜澄果團隊</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: { extend: {
      colors: { ink:'#16191D', inkSoft:'#474D55', inkFaint:'#737A83',
        paper:'#F4F4F2', surface:'#FFFFFF', line:'#DEDCD7',
        orange:'#FD7305', orangeDeep:'#B85400', tint:'#FCEFE3',
        pass:'#2F6B4F', fail:'#A8341F' },
      fontFamily: { sans:['"Noto Sans TC"','sans-serif'], mono:['"IBM Plex Mono"','monospace'] },
      borderRadius: { DEFAULT:'3px', sm:'2px', md:'4px' },
    }}
  }
</script>
<script src="https://unpkg.com/react@18/umd/react.development.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
<script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

<style>
  body { background:#F4F4F2; -webkit-font-smoothing:antialiased; }
  ::selection { background:#FD7305; color:#fff; }
  .display { font-weight:900; letter-spacing:-0.02em; line-height:1.25; }
  :focus-visible { outline:2px solid #FD7305; outline-offset:2px; }
  textarea { resize: vertical; }
</style>
</head>
<body class="font-sans text-ink">
<div id="root"></div>

<script type="text/babel">
const { useState, useEffect, useRef } = React;

const TAGS = ["首購", "換屋", "稅務", "生活圈", "市場觀察"];
const BLOCK_TYPES = [
  { type: "h",     label: "小標題" },
  { type: "p",     label: "段落" },
  { type: "list",  label: "條列" },
  { type: "table", label: "表格" },
  { type: "note",  label: "提醒框" },
  { type: "quote", label: "引言" },
  { type: "image", label: "圖片" },
];

const IMG_DIR = "assets/articles";

const DATA_PATH = "data/articles.json";

/* ---------- 工具 ---------- */
const todayStr = () => new Date().toISOString().slice(0, 10);

function addMonths(dateStr, m) {
  const d = new Date(dateStr);
  d.setMonth(d.getMonth() + m);
  return d.toISOString().slice(0, 10);
}

function slugify(title) {
  return title.trim().toLowerCase()
    .replace(/[^\w\u4e00-\u9fff]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 60) || `article-${Date.now()}`;
}

/* UTF-8 安全的 base64（GitHub API 需要） */
function toBase64(str) {
  const bytes = new TextEncoder().encode(str);
  let bin = "";
  bytes.forEach(b => { bin += String.fromCharCode(b); });
  return btoa(bin);
}

/* 上傳前先在瀏覽器壓縮，避免圖片太大拖慢網站 */
function compressImage(file, maxW = 1600, quality = 0.82) {
  return new Promise((resolve, reject) => {
    const img = new Image();
    const url = URL.createObjectURL(file);
    img.onload = () => {
      URL.revokeObjectURL(url);
      const scale = Math.min(1, maxW / img.width);
      const w = Math.round(img.width * scale);
      const h = Math.round(img.height * scale);
      const canvas = document.createElement("canvas");
      canvas.width = w; canvas.height = h;
      const ctx = canvas.getContext("2d");
      ctx.fillStyle = "#fff";
      ctx.fillRect(0, 0, w, h);
      ctx.drawImage(img, 0, 0, w, h);
      canvas.toBlob(b => b ? resolve({ blob: b, w, h }) : reject(new Error("壓縮失敗")), "image/jpeg", quality);
    };
    img.onerror = () => { URL.revokeObjectURL(url); reject(new Error("這個檔案不是有效的圖片")); };
    img.src = url;
  });
}

function blobToBase64(blob) {
  return new Promise((resolve, reject) => {
    const r = new FileReader();
    r.onload = () => resolve(String(r.result).split(",")[1]);
    r.onerror = reject;
    r.readAsDataURL(blob);
  });
}

function safeFileName(name) {
  const base = name.replace(/\.[^.]+$/, "")
    .toLowerCase()
    .replace(/[^a-z0-9\u4e00-\u9fff]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 40) || "image";
  const stamp = new Date().toISOString().slice(0,10).replace(/-/g, "");
  return `${stamp}-${base}-${Math.random().toString(36).slice(2,6)}.jpg`;
}

/* 把貼進來的長文自動拆成區塊：
   【標題】或「一、」開頭 → 小標；短行且以冒號結尾 → 小標；其餘為段落 */
function parseLongText(raw) {
  const lines = String(raw || "")
    .replace(/\r/g, "")
    .split(/\n+/)
    .map(l => l.trim())
    .filter(Boolean);

  const blocks = [];
  let buffer = [];

  const flush = () => {
    if (buffer.length) { blocks.push({ type: "p", text: buffer.join("\n") }); buffer = []; }
  };

  lines.forEach(line => {
    const bracket = line.match(/^【(.+?)】\s*(.*)$/);
    const numbered = /^[一二三四五六七八九十]+[、.]/.test(line) && line.length < 30;
    const shortHead = line.length < 24 && /[:：]$/.test(line);

    if (bracket) {
      flush();
      blocks.push({ type: "h", text: bracket[1].trim() });
      if (bracket[2]) buffer.push(bracket[2].trim());
    } else if (numbered || shortHead) {
      flush();
      blocks.push({ type: "h", text: line.replace(/[:：]$/, "") });
    } else if (/^[-・･•‧]\s*/.test(line)) {
      // 條列項目：連續的收在一起
      const last = blocks[blocks.length - 1];
      const item = line.replace(/^[-・･•‧]\s*/, "");
      if (buffer.length) flush();
      if (last && last.type === "list") last.items.push(item);
      else blocks.push({ type: "list", items: [item] });
    } else {
      buffer.push(line);
    }
  });
  flush();
  return blocks.length ? blocks : [{ type: "p", text: raw }];
}

function emptyBlock(type) {
  switch (type) {
    case "table": return { type, head: ["項目", "說明"], rows: [["", ""]] };
    case "list":  return { type, items: [""] };
    case "image": return { type, src: "", alt: "", caption: "" };
    default:      return { type, text: "" };
  }
}

function newArticle() {
  const d = todayStr();
  return {
    slug: "", tag: "首購", title: "", summary: "",
    date: d, updated: d, reviewBy: addMonths(d, 6),
    readMinutes: 5, draft: true,
    blocks: [{ type: "p", text: "" }],
  };
}

/* ---------- 小元件 ---------- */
function Label({ children, hint }) {
  return (
    <div className="mb-2">
      <span className="font-mono text-[12px] tracking-wider text-inkFaint">{children}</span>
      {hint && <span className="block text-[12px] text-inkFaint mt-0.5 leading-relaxed">{hint}</span>}
    </div>
  );
}

const inputCls = "w-full border border-line rounded-sm px-4 py-2.5 text-[15px] bg-surface focus:border-orange outline-none";

function Btn({ children, onClick, variant = "solid", size = "md", disabled, title }) {
  const sizes = size === "sm" ? "px-3 py-1.5 text-[13px]" : "px-6 py-3 text-[15px]";
  const styles = {
    solid: "bg-orange text-white hover:bg-orangeDeep disabled:bg-line disabled:text-inkFaint",
    outline: "border border-line text-inkSoft hover:border-ink hover:text-ink",
    danger: "border border-fail/40 text-fail hover:bg-fail hover:text-white",
    dark: "bg-ink text-white hover:bg-black",
  };
  return (
    <button onClick={onClick} disabled={disabled} title={title}
      className={`inline-flex items-center justify-center font-medium rounded-sm transition ${sizes} ${styles[variant]}`}>
      {children}
    </button>
  );
}

/* ---------- 圖片選擇／上傳 ---------- */
function ImagePicker({ src, onPick, uploader, label = "圖片" }) {
  const ref = useRef(null);
  const [busy, setBusy] = useState(false);
  const [err, setErr] = useState("");

  const handle = async e => {
    const f = e.target.files?.[0];
    e.target.value = "";
    if (!f) return;
    setErr(""); setBusy(true);
    try {
      const path = await uploader(f);
      onPick(path);
    } catch (ex) {
      setErr(ex.message || String(ex));
    } finally { setBusy(false); }
  };

  return (
    <div>
      <Label>{label}</Label>
      {src ? (
        <div className="flex gap-3 items-start">
          <img src={`../${src}`} alt="" className="w-32 aspect-[3/2] object-contain bg-paper rounded-sm border border-line shrink-0"
            onError={e => { e.target.style.opacity = 0.25; }} />
          <div className="flex-1 min-w-0">
            <div className="font-mono text-[12px] text-inkFaint break-all mb-2">{src}</div>
            <div className="flex gap-2">
              <Btn size="sm" variant="outline" onClick={() => ref.current.click()} disabled={busy}>
                {busy ? "上傳中…" : "換一張"}
              </Btn>
              <Btn size="sm" variant="outline" onClick={() => onPick("")}>移除</Btn>
            </div>
          </div>
        </div>
      ) : (
        <div>
          <Btn size="sm" variant="outline" onClick={() => ref.current.click()} disabled={busy}>
            {busy ? "上傳中…" : "＋ 選擇圖片"}
          </Btn>
          <p className="text-[12px] text-inkFaint mt-2 leading-relaxed">
            會自動縮到寬 1600px 並壓縮，避免拖慢網站。
          </p>
        </div>
      )}
      <input ref={ref} type="file" accept="image/*" className="hidden" onChange={handle} />
      {err && <p className="text-[13px] text-fail mt-2 leading-relaxed">{err}</p>}
      <input className={inputCls + " mt-3"} value={src || ""} placeholder="或直接填路徑：assets/articles/xxx.jpg"
        onChange={e => onPick(e.target.value)} />
    </div>
  );
}

/* ---------- 區塊編輯器 ---------- */
function BlockEditor({ block, onChange, onRemove, onMove, isFirst, isLast, uploader }) {
  const meta = BLOCK_TYPES.find(b => b.type === block.type);

  const set = patch => onChange({ ...block, ...patch });

  return (
    <div className="border border-line rounded-sm bg-surface">
      <div className="flex items-center justify-between px-4 py-2.5 border-b border-line bg-paper">
        <div className="flex items-center gap-3">
          <span className="font-mono text-[12px] tracking-wider text-orangeDeep">{meta?.label}</span>
          {(block.showFrom || block.showUntil) && (
            <span className="font-mono text-[11px] text-inkFaint">
              {block.showFrom && `${block.showFrom} 起`}
              {block.showUntil && `${block.showUntil} 前`}
            </span>
          )}
        </div>
        <div className="flex items-center gap-1.5">
          <Btn size="sm" variant="outline" onClick={() => onMove(-1)} disabled={isFirst} title="上移">↑</Btn>
          <Btn size="sm" variant="outline" onClick={() => onMove(1)} disabled={isLast} title="下移">↓</Btn>
          <Btn size="sm" variant="danger" onClick={onRemove} title="刪除">刪除</Btn>
        </div>
      </div>

      <div className="p-4 space-y-3">
        {(block.type === "h" || block.type === "p" || block.type === "note" || block.type === "quote") && (
          <textarea rows={block.type === "h" || block.type === "quote" ? 2 : 4}
            className={inputCls}
            placeholder={
              block.type === "h" ? "小標題文字" :
              block.type === "quote" ? "想強調的一句話" :
              block.type === "note" ? "提醒或警語，會顯示成橘色框" :
              "段落內容。換行會自動分段。想強調的字用 **兩個星號** 包起來會變粗體。"}
            value={block.text || ""}
            onChange={e => set({ text: e.target.value })} />
        )}

        {block.type === "list" && (
          <div className="space-y-2">
            {(block.items || []).map((it, i) => (
              <div key={i} className="flex gap-2">
                <span className="font-mono text-[12px] text-inkFaint pt-3 w-6 shrink-0">{String(i+1).padStart(2,"0")}</span>
                <textarea rows={2} className={inputCls} value={it}
                  placeholder="條列項目"
                  onChange={e => {
                    const items = [...block.items]; items[i] = e.target.value; set({ items });
                  }} />
                <Btn size="sm" variant="outline"
                  onClick={() => set({ items: block.items.filter((_, j) => j !== i) })}>✕</Btn>
              </div>
            ))}
            <Btn size="sm" variant="outline" onClick={() => set({ items: [...(block.items||[]), ""] })}>
              ＋ 新增一項
            </Btn>
          </div>
        )}

        {block.type === "table" && (
          <div className="space-y-3">
            <div>
              <Label>欄位名稱</Label>
              <div className="flex gap-2">
                {block.head.map((h, i) => (
                  <input key={i} className={inputCls} value={h}
                    onChange={e => { const head=[...block.head]; head[i]=e.target.value; set({head}); }} />
                ))}
                <Btn size="sm" variant="outline"
                  onClick={() => set({ head: [...block.head, ""], rows: block.rows.map(r => [...r, ""]) })}>＋欄</Btn>
                {block.head.length > 2 && (
                  <Btn size="sm" variant="outline"
                    onClick={() => set({ head: block.head.slice(0,-1), rows: block.rows.map(r => r.slice(0,-1)) })}>−欄</Btn>
                )}
              </div>
            </div>
            <div>
              <Label>資料列</Label>
              <div className="space-y-2">
                {block.rows.map((row, ri) => (
                  <div key={ri} className="flex gap-2">
                    {row.map((cell, ci) => (
                      <input key={ci} className={inputCls} value={cell}
                        onChange={e => {
                          const rows = block.rows.map(r => [...r]);
                          rows[ri][ci] = e.target.value; set({ rows });
                        }} />
                    ))}
                    <Btn size="sm" variant="outline"
                      onClick={() => set({ rows: block.rows.filter((_, j) => j !== ri) })}>✕</Btn>
                  </div>
                ))}
              </div>
              <div className="mt-2">
                <Btn size="sm" variant="outline"
                  onClick={() => set({ rows: [...block.rows, block.head.map(() => "")] })}>＋ 新增一列</Btn>
              </div>
            </div>
          </div>
        )}

        {block.type === "image" && (
          <div className="space-y-4">
            <ImagePicker src={block.src} uploader={uploader}
              onPick={v => set({ src: v })} label="插圖" />
            <div>
              <Label hint="給看不到圖片的人與搜尋引擎看的描述">替代文字</Label>
              <input className={inputCls} value={block.alt || ""}
                placeholder="例如：農十六特區空拍"
                onChange={e => set({ alt: e.target.value })} />
            </div>
            <div>
              <Label hint="顯示在圖片下方，可留空">圖說</Label>
              <input className={inputCls} value={block.caption || ""}
                placeholder="例如：農十六特區：街廓方正、道路寬闊（空拍模擬圖）"
                onChange={e => set({ caption: e.target.value })} />
            </div>
          </div>
        )}

        <details className="pt-1">
          <summary className="cursor-pointer font-mono text-[12px] text-inkFaint select-none">
            排程顯示（選填）
          </summary>
          <div className="grid sm:grid-cols-2 gap-3 mt-3">
            <div>
              <Label hint="這個日期起才顯示">起始日</Label>
              <input type="date" className={inputCls} value={block.showFrom || ""}
                onChange={e => set({ showFrom: e.target.value || undefined })} />
            </div>
            <div>
              <Label hint="這個日期起就隱藏">結束日</Label>
              <input type="date" className={inputCls} value={block.showUntil || ""}
                onChange={e => set({ showUntil: e.target.value || undefined })} />
            </div>
          </div>
          <p className="text-[12px] text-inkFaint mt-2 leading-relaxed">
            用來做「時間到自動換句話」。例如寫兩段話，一段設結束日、一段設起始日為同一天，
            那天一到網站就會自動切換。
          </p>
        </details>
      </div>
    </div>
  );
}

/* ---------- 預覽 ---------- */
function PreviewBlock({ block }) {
  const rich = t => {
    const parts = String(t || "").split(/(\*\*[^*]+\*\*)/g);
    return parts.map((p, i) =>
      p.startsWith("**") && p.endsWith("**")
        ? <strong key={i} className="font-bold text-ink">{p.slice(2,-2)}</strong>
        : <React.Fragment key={i}>{p}</React.Fragment>);
  };

  switch (block.type) {
    case "h": return <h2 className="display text-[19px] mt-10 mb-5 pt-6 border-t border-line">{block.text}</h2>;
    case "p": {
      const paras = String(block.text||"").split(/\n\s*\n|\n/).map(t=>t.trim()).filter(Boolean);
      return (
        <div className="mb-6">
          {paras.map((t,i) => (
            <p key={i} className="text-[15px] leading-[2] text-inkSoft mb-4 last:mb-0">{rich(t)}</p>
          ))}
        </div>
      );
    }
    case "list": return (
      <ul className="mb-5 space-y-2">
        {(block.items||[]).map((it,i) => (
          <li key={i} className="flex gap-2.5 text-[15px] leading-[1.9] text-inkSoft">
            <span className="font-mono text-[12px] text-orangeDeep pt-1 shrink-0">{String(i+1).padStart(2,"0")}</span>
            <span>{rich(it)}</span>
          </li>
        ))}
      </ul>
    );
    case "table": return (
      <div className="mb-5 overflow-x-auto">
        <table className="w-full text-[14px] border border-line bg-surface">
          <thead><tr className="border-b border-line bg-paper">
            {block.head.map((h,i) => (
              <th key={i} className={`font-mono text-[12px] text-inkFaint font-normal py-2.5 px-3 ${i===0?"text-left":"text-right"}`}>{h}</th>
            ))}
          </tr></thead>
          <tbody>
            {block.rows.map((r,i) => (
              <tr key={i} className="border-b border-line last:border-0">
                {r.map((c,j) => (
                  <td key={j} className={`py-2.5 px-3 ${j===0?"text-ink":"text-right text-inkSoft"}`}>{rich(c)}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    );
    case "note": return (
      <div className="mb-5 bg-tint border-l-2 border-orange px-5 py-4">
        <p className="text-[14px] leading-[1.9] text-orangeDeep">{rich(block.text)}</p>
      </div>
    );
    case "quote": return (
      <blockquote className="my-7 py-5 border-y-2 border-ink">
        <p className="display text-[17px] leading-[1.6]">{block.text}</p>
      </blockquote>
    );
    case "image": return block.src ? (
      <figure className="my-6">
        <img src={`../${block.src}`} alt={block.alt||""} className="w-full h-auto rounded-sm border border-line bg-paper" />
        {block.caption && <figcaption className="mt-2 text-[13px] text-inkFaint">{block.caption}</figcaption>}
      </figure>
    ) : (
      <div className="my-6 aspect-[3/2] border border-dashed border-line rounded-sm flex items-center justify-center font-mono text-[12px] text-inkFaint">
        尚未選擇圖片
      </div>
    );
    default: return null;
  }
}

/* ---------- 主程式 ---------- */
function App() {
  const [data, setData] = useState(null);
  const [loadErr, setLoadErr] = useState("");
  const [idx, setIdx] = useState(null);        // 目前編輯第幾篇（null = 未選）
  const [draftArticle, setDraft] = useState(null);
  const [msg, setMsg] = useState(null);        // {type, text}
  const [showPublish, setShowPublish] = useState(false);
  const [token, setToken] = useState("");
  const [repo, setRepo] = useState("twhouse416/chengguo-site");
  const [busy, setBusy] = useState(false);
  const [bulkText, setBulkText] = useState("");
  const fileRef = useRef(null);

  useEffect(() => {
    fetch("../data/articles.json")
      .then(r => { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(setData)
      .catch(e => setLoadErr(String(e)));
    setToken(sessionStorage.getItem("cg_token") || "");
  }, []);

  const flash = (type, text) => { setMsg({ type, text }); setTimeout(() => setMsg(null), 6000); };

  const startNew = () => { setDraft(newArticle()); setIdx(-1); };
  const startEdit = i => { setDraft(JSON.parse(JSON.stringify(data.articles[i]))); setIdx(i); };
  const cancel = () => { setDraft(null); setIdx(null); };

  const saveToList = () => {
    if (!draftArticle.title.trim()) { flash("fail", "標題不能空白"); return; }
    const a = { ...draftArticle, updated: todayStr() };
    if (!a.slug.trim()) a.slug = slugify(a.title);

    const articles = [...data.articles];
    if (idx === -1) {
      if (articles.some(x => x.slug === a.slug)) { flash("fail", "這個網址代號已經有人用了，請改一個"); return; }
      articles.unshift(a);
    } else {
      articles[idx] = a;
    }
    setData({ ...data, articles });
    setDraft(null); setIdx(null);
    flash("pass", idx === -1 ? "已加入列表，記得按下方「發布」或「下載」才會真的更新網站" : "已更新，記得發布或下載");
  };

  const removeArticle = i => {
    if (!confirm(`確定要刪除「${data.articles[i].title}」？`)) return;
    setData({ ...data, articles: data.articles.filter((_, j) => j !== i) });
    flash("pass", "已從列表移除，記得發布或下載才會生效");
  };

  const toggleDraft = i => {
    const articles = [...data.articles];
    articles[i] = { ...articles[i], draft: !articles[i].draft };
    setData({ ...data, articles });
  };

  const jsonText = () => JSON.stringify(data, null, 2) + "\n";

  const download = () => {
    const blob = new Blob([jsonText()], { type: "application/json;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url; a.download = "articles.json"; a.click();
    URL.revokeObjectURL(url);
    flash("pass", "已下載 articles.json，請上傳到 GitHub 的 data 資料夾覆蓋原檔");
  };

  const copyJson = async () => {
    try { await navigator.clipboard.writeText(jsonText()); flash("pass", "已複製，可貼到 GitHub 上覆蓋 data/articles.json"); }
    catch { flash("fail", "複製失敗，請改用下載"); }
  };

  const importFile = e => {
    const f = e.target.files?.[0]; if (!f) return;
    const r = new FileReader();
    r.onload = () => {
      try { const d = JSON.parse(r.result); if (!Array.isArray(d.articles)) throw 0; setData(d); flash("pass", "已載入檔案"); }
      catch { flash("fail", "這個檔案格式不對"); }
    };
    r.readAsText(f);
  };

  /* 上傳圖片到 repo 的 assets/articles/，回傳網站根目錄起算的路徑 */
  const uploadImage = async file => {
    if (!token.trim()) {
      throw new Error("要上傳圖片需要先在「發布設定」填入 GitHub 權杖。或是自行把圖片放到 assets/articles/ 後，在下方欄位填路徑。");
    }
    const { blob, w, h } = await compressImage(file);
    const name = safeFileName(file.name);
    const path = `${IMG_DIR}/${name}`;
    const content = await blobToBase64(blob);

    const api = `https://api.github.com/repos/${repo.trim()}/contents/${path}`;
    const res = await fetch(api, {
      method: "PUT",
      headers: {
        Authorization: `Bearer ${token.trim()}`,
        Accept: "application/vnd.github+json",
        "Content-Type": "application/json",
      },
      body: JSON.stringify({ message: `上傳圖片 ${name}`, content }),
    });
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      throw new Error(`上傳失敗（${res.status}）${err.message ? "：" + err.message : ""}`);
    }
    flash("pass", `圖片已上傳（${w}×${h}，${Math.round(blob.size/1024)} KB）`);
    return path;
  };

  const publish = async () => {
    if (!token.trim()) { flash("fail", "請先填入 GitHub 權杖"); return; }
    setBusy(true);
    try {
      const api = `https://api.github.com/repos/${repo.trim()}/contents/${DATA_PATH}`;
      const headers = { Authorization: `Bearer ${token.trim()}`, Accept: "application/vnd.github+json" };

      const getRes = await fetch(api, { headers });
      if (!getRes.ok) throw new Error(`讀取失敗（${getRes.status}）。請確認權杖權限與儲存庫名稱。`);
      const cur = await getRes.json();

      const putRes = await fetch(api, {
        method: "PUT", headers: { ...headers, "Content-Type": "application/json" },
        body: JSON.stringify({
          message: `更新文章 ${todayStr()}`,
          content: toBase64(jsonText()),
          sha: cur.sha,
        }),
      });
      if (!putRes.ok) {
        const err = await putRes.json().catch(() => ({}));
        throw new Error(`發布失敗（${putRes.status}）${err.message ? "：" + err.message : ""}`);
      }
      sessionStorage.setItem("cg_token", token.trim());
      flash("pass", "發布成功！網站約 1–2 分鐘後更新。");
    } catch (e) {
      flash("fail", e.message || String(e));
    } finally { setBusy(false); }
  };

  /* ---- 畫面 ---- */
  if (loadErr) return (
    <div className="max-w-2xl mx-auto px-6 py-20">
      <h1 className="display text-[24px] mb-4">讀不到文章資料</h1>
      <p className="text-[16px] text-inkSoft leading-[1.9]">
        後台需要透過網址開啟才能讀取資料，不能直接雙擊本機檔案。
        請用 <span className="font-mono text-[14px]">你的網站網址/admin/</span> 開啟。
      </p>
    </div>
  );

  if (!data) return <div className="max-w-2xl mx-auto px-6 py-20 font-mono text-[13px] text-inkFaint">讀取中…</div>;

  return (
    <div className="min-h-screen">
      <header className="sticky top-0 z-50 bg-paper/95 backdrop-blur-sm border-b border-line">
        <div className="max-w-6xl mx-auto px-6 h-[68px] flex items-center justify-between gap-4">
          <div className="flex items-center gap-3">
            <img src="../assets/logo-icon.png" alt="" className="w-9 h-9 object-contain" />
            <span className="leading-tight">
              <span className="block font-mono text-[11px] tracking-[0.2em] text-inkFaint">ADMIN</span>
              <span className="block text-[17px] font-bold tracking-tight">文章後台</span>
            </span>
          </div>
          <div className="flex items-center gap-2">
            <Btn variant="outline" size="sm" onClick={() => fileRef.current.click()}>載入檔案</Btn>
            <input ref={fileRef} type="file" accept=".json" className="hidden" onChange={importFile} />
            <Btn variant="outline" size="sm" onClick={download}>下載</Btn>
            <Btn variant="dark" size="sm" onClick={() => setShowPublish(!showPublish)}>發布設定</Btn>
          </div>
        </div>

        {msg && (
          <div className={`px-6 py-3 text-[14px] ${msg.type === "pass" ? "bg-pass text-white" : "bg-fail text-white"}`}>
            <div className="max-w-6xl mx-auto">{msg.text}</div>
          </div>
        )}
      </header>

      {showPublish && (
        <div className="bg-surface border-b border-line">
          <div className="max-w-6xl mx-auto px-6 py-7">
            <h2 className="display text-[19px] mb-3">直接發布到網站</h2>
            <p className="text-[15px] text-inkSoft leading-[1.9] mb-5 max-w-3xl">
              填入 GitHub 權杖後，按「發布」就會直接更新網站，不用手動上傳。
              權杖只存在這個瀏覽器分頁，關掉分頁就會清除。
            </p>
            <div className="bg-tint border-l-2 border-orange px-5 py-4 mb-5 max-w-3xl">
              <p className="text-[14px] text-orangeDeep leading-[1.9]">
                權杖等同你的 GitHub 帳號權限，請勿在公用電腦使用，也不要給別人。
                建議用 Fine-grained token，權限只開這一個儲存庫的 Contents 讀寫。
                <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener noreferrer"
                  className="underline ml-1">前往建立權杖 →</a>
              </p>
            </div>
            <div className="grid md:grid-cols-2 gap-5 max-w-3xl">
              <div>
                <Label>儲存庫</Label>
                <input className={inputCls} value={repo} onChange={e => setRepo(e.target.value)} />
              </div>
              <div>
                <Label hint="貼上後不會顯示在畫面上">GitHub 權杖</Label>
                <input type="password" className={inputCls} value={token}
                  placeholder="github_pat_..." onChange={e => setToken(e.target.value)} />
              </div>
            </div>
            <div className="mt-5 flex flex-wrap gap-3">
              <Btn onClick={publish} disabled={busy}>{busy ? "發布中…" : "發布到網站"}</Btn>
              <Btn variant="outline" onClick={copyJson}>複製 JSON</Btn>
              <Btn variant="outline" onClick={() => { sessionStorage.removeItem("cg_token"); setToken(""); flash("pass","已清除權杖"); }}>
                清除權杖
              </Btn>
            </div>
          </div>
        </div>
      )}

      <main className="max-w-6xl mx-auto px-6 py-10">
        {/* 列表模式 */}
        {draftArticle === null && (
          <>
            <div className="flex items-center justify-between mb-8">
              <div>
                <h1 className="display text-[26px]">文章列表</h1>
                <p className="text-[15px] text-inkSoft mt-2">
                  共 {data.articles.length} 篇，其中 {data.articles.filter(a => a.draft).length} 篇為草稿（網站上看不到）
                </p>
              </div>
              <Btn onClick={startNew}>＋ 寫新文章</Btn>
            </div>

            <div className="border border-line rounded-sm overflow-hidden">
              {data.articles.map((a, i) => (
                <div key={a.slug + i}
                  className="bg-surface border-b border-line last:border-0 p-5 flex flex-wrap items-center gap-4">
                  <div className="flex-1 min-w-[240px]">
                    <div className="flex items-center gap-3 mb-1.5">
                      <span className="font-mono text-[12px] text-orangeDeep tracking-wider">{a.tag}</span>
                      <span className="font-mono text-[12px] text-inkFaint">{a.date}</span>
                      {a.draft
                        ? <span className="font-mono text-[11px] text-inkFaint border border-line rounded-sm px-2 py-0.5">草稿</span>
                        : <span className="font-mono text-[11px] text-pass border border-pass/40 rounded-sm px-2 py-0.5">已發布</span>}
                      {a.reviewBy && a.reviewBy <= todayStr() && (
                        <span className="font-mono text-[11px] text-orangeDeep border border-orange/40 rounded-sm px-2 py-0.5">該檢視了</span>
                      )}
                    </div>
                    <div className="text-[16px] font-bold tracking-tight">{a.title || "（未命名）"}</div>
                  </div>
                  <div className="flex items-center gap-2">
                    <Btn size="sm" variant="outline" onClick={() => toggleDraft(i)}>
                      {a.draft ? "設為發布" : "收回草稿"}
                    </Btn>
                    <Btn size="sm" variant="outline" onClick={() => startEdit(i)}>編輯</Btn>
                    <Btn size="sm" variant="danger" onClick={() => removeArticle(i)}>刪除</Btn>
                  </div>
                </div>
              ))}
              {data.articles.length === 0 && (
                <div className="bg-surface p-8 text-[15px] text-inkSoft">還沒有文章，按右上角開始寫第一篇。</div>
              )}
            </div>

            <div className="mt-8 bg-surface border border-line rounded-sm p-6">
              <h2 className="font-mono text-[12px] tracking-[0.18em] text-orangeDeep uppercase mb-3">怎麼讓修改生效</h2>
              <p className="text-[15px] text-inkSoft leading-[1.9]">
                在這裡的編輯只存在你的瀏覽器裡。改完之後要選一種方式送出去：
                填了權杖就按「發布到網站」，或是按「下載」把 articles.json 上傳到 GitHub 的 data 資料夾覆蓋原檔。
                兩種方式效果一樣。
              </p>
            </div>
          </>
        )}

        {/* 編輯模式 */}
        {draftArticle && (
          <div className="grid lg:grid-cols-2 gap-8">
            <div>
              <div className="flex items-center justify-between mb-6">
                <h1 className="display text-[22px]">{idx === -1 ? "寫新文章" : "編輯文章"}</h1>
                <div className="flex gap-2">
                  <Btn size="sm" variant="outline" onClick={cancel}>取消</Btn>
                  <Btn size="sm" onClick={saveToList}>完成</Btn>
                </div>
              </div>

              <div className="bg-surface border border-line rounded-sm p-6 space-y-5">
                <div>
                  <Label>標題</Label>
                  <input className={inputCls} value={draftArticle.title}
                    placeholder="例如：新青安 3.0 上路：額度提高了，但多了三道門檻"
                    onChange={e => setDraft({ ...draftArticle, title: e.target.value })} />
                </div>

                <div>
                  <Label hint="列表上會顯示這段，寫得具體一點比較吸引人點進來">摘要</Label>
                  <textarea rows={3} className={inputCls} value={draftArticle.summary}
                    onChange={e => setDraft({ ...draftArticle, summary: e.target.value })} />
                </div>

                <ImagePicker src={draftArticle.cover} uploader={uploadImage} label="封面圖（選填）"
                  onPick={v => setDraft({ ...draftArticle, cover: v || undefined })} />

                {draftArticle.cover && (
                  <div>
                    <Label hint="給看不到圖片的人與搜尋引擎看的描述">封面替代文字</Label>
                    <input className={inputCls} value={draftArticle.coverAlt || ""}
                      onChange={e => setDraft({ ...draftArticle, coverAlt: e.target.value })} />
                  </div>
                )}

                <div className="grid sm:grid-cols-2 gap-4">
                  <div>
                    <Label>分類</Label>
                    <select className={inputCls} value={draftArticle.tag}
                      onChange={e => setDraft({ ...draftArticle, tag: e.target.value })}>
                      {TAGS.map(t => <option key={t}>{t}</option>)}
                    </select>
                  </div>
                  <div>
                    <Label hint="留空會自動依標題產生">網址代號</Label>
                    <input className={inputCls} value={draftArticle.slug}
                      placeholder="qingan-3-0-thresholds"
                      onChange={e => setDraft({ ...draftArticle, slug: e.target.value })} />
                  </div>
                  <div>
                    <Label>發布日期</Label>
                    <input type="date" className={inputCls} value={draftArticle.date}
                      onChange={e => setDraft({ ...draftArticle, date: e.target.value })} />
                  </div>
                  <div>
                    <Label hint="超過這天，文章會自動顯示時效提醒">下次檢視</Label>
                    <input type="date" className={inputCls} value={draftArticle.reviewBy || ""}
                      onChange={e => setDraft({ ...draftArticle, reviewBy: e.target.value })} />
                  </div>
                  <div>
                    <Label>閱讀時間（分鐘）</Label>
                    <input type="number" min="1" className={inputCls} value={draftArticle.readMinutes}
                      onChange={e => setDraft({ ...draftArticle, readMinutes: Number(e.target.value) })} />
                  </div>
                  <div>
                    <Label>狀態</Label>
                    <select className={inputCls} value={draftArticle.draft ? "draft" : "published"}
                      onChange={e => setDraft({ ...draftArticle, draft: e.target.value === "draft" })}>
                      <option value="draft">草稿（網站看不到）</option>
                      <option value="published">發布</option>
                    </select>
                  </div>
                </div>
              </div>

              <div className="mt-6 space-y-4">
                {draftArticle.blocks.map((b, i) => (
                  <BlockEditor key={i} block={b} uploader={uploadImage}
                    isFirst={i === 0} isLast={i === draftArticle.blocks.length - 1}
                    onChange={nb => {
                      const blocks = [...draftArticle.blocks]; blocks[i] = nb;
                      setDraft({ ...draftArticle, blocks });
                    }}
                    onRemove={() => setDraft({ ...draftArticle, blocks: draftArticle.blocks.filter((_, j) => j !== i) })}
                    onMove={dir => {
                      const blocks = [...draftArticle.blocks];
                      const j = i + dir; if (j < 0 || j >= blocks.length) return;
                      [blocks[i], blocks[j]] = [blocks[j], blocks[i]];
                      setDraft({ ...draftArticle, blocks });
                    }} />
                ))}
              </div>

              <div className="mt-5 flex flex-wrap gap-2">
                {BLOCK_TYPES.map(t => (
                  <Btn key={t.type} size="sm" variant="outline"
                    onClick={() => setDraft({ ...draftArticle, blocks: [...draftArticle.blocks, emptyBlock(t.type)] })}>
                    ＋ {t.label}
                  </Btn>
                ))}
              </div>

              <details className="mt-6 bg-surface border border-line rounded-sm">
                <summary className="cursor-pointer px-5 py-4 text-[15px] font-medium select-none">
                  貼上長文，自動分段
                </summary>
                <div className="px-5 pb-5">
                  <p className="text-[14px] text-inkSoft leading-[1.9] mb-3">
                    從 Word、記事本或其他地方複製整篇文章貼進來，會依換行自動拆成段落。
                    用【】框起來的、或以「一、」開頭的短行會變成小標，以「‧」開頭的會變成條列。
                    拆完之後可以再逐一調整。
                  </p>
                  <textarea rows={8} className={inputCls} value={bulkText}
                    placeholder="把整篇文章貼在這裡…"
                    onChange={e => setBulkText(e.target.value)} />
                  <div className="mt-3 flex flex-wrap gap-2">
                    <Btn size="sm"
                      onClick={() => {
                        if (!bulkText.trim()) { flash("fail", "請先貼上內容"); return; }
                        const nb = parseLongText(bulkText);
                        setDraft({ ...draftArticle, blocks: [...draftArticle.blocks, ...nb] });
                        setBulkText("");
                        flash("pass", `已加入 ${nb.length} 個區塊`);
                      }}>
                      加到文章末尾
                    </Btn>
                    <Btn size="sm" variant="outline"
                      onClick={() => {
                        if (!bulkText.trim()) { flash("fail", "請先貼上內容"); return; }
                        if (!confirm("這會取代目前所有內文區塊，確定嗎？")) return;
                        const nb = parseLongText(bulkText);
                        setDraft({ ...draftArticle, blocks: nb });
                        setBulkText("");
                        flash("pass", `已取代為 ${nb.length} 個區塊`);
                      }}>
                      取代全部內容
                    </Btn>
                  </div>
                </div>
              </details>

              <div className="mt-8 flex gap-3">
                <Btn onClick={saveToList}>完成，回到列表</Btn>
                <Btn variant="outline" onClick={cancel}>取消不儲存</Btn>
              </div>
            </div>

            {/* 預覽 */}
            <div className="lg:sticky lg:top-[92px] lg:self-start">
              <div className="font-mono text-[12px] tracking-[0.18em] text-orangeDeep uppercase mb-4">預覽</div>
              <div className="bg-surface border border-line rounded-sm p-7 max-h-[75vh] overflow-y-auto">
                <div className="flex items-center gap-4 font-mono text-[12px] mb-3">
                  <span className="text-orangeDeep tracking-wider">{draftArticle.tag}</span>
                  <span className="text-inkFaint">{draftArticle.date}</span>
                  <span className="text-inkFaint">約 {draftArticle.readMinutes} 分鐘</span>
                </div>
                <h1 className="display text-[24px]">{draftArticle.title || "（標題）"}</h1>
                {draftArticle.summary && (
                  <p className="mt-4 text-[15px] text-inkSoft leading-[1.95]">{draftArticle.summary}</p>
                )}
                {draftArticle.cover && (
                  <img src={`../${draftArticle.cover}`} alt=""
                    className="w-full h-auto rounded-sm border border-line bg-paper mt-6" />
                )}
                <div className="mt-8">
                  {draftArticle.blocks.map((b, i) => <PreviewBlock key={i} block={b} />)}
                </div>
              </div>
            </div>
          </div>
        )}
      </main>
    </div>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<App />);
</script>
</body>
</html>
